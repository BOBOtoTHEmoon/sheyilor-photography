# Copy this file to .env.local and fill in the values.

# Public address of the site (no trailing slash). Use http://localhost:3000 while testing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (Settings > API Keys & Webhooks). Use the test keys first.
PAYSTACK_SECRET_KEY=

# Resend, for booking and payment emails
RESEND_API_KEY=
EMAIL_FROM="Sheyilor Photography <bookings@sheyilorphotography.com>"
# Where new booking alerts go
STUDIO_EMAIL=sheyilorphotography@gmail.com

# Cloudflare R2, for client galleries (Phase 2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
